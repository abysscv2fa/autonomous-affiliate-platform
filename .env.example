APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://app:app_password@db:5432/affiliate
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
