APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://app:app_password@db:5432/affiliate
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
# Use two different long random secrets in production.
# Backend: FRONTEND_PROXY_TOKEN is used only by the Nuxt server proxy.
# Backend + GitHub Actions: AUTOPILOT_TOKEN is used only by scheduled jobs.
# Frontend: BACKEND_API_TOKEN must exactly match backend FRONTEND_PROXY_TOKEN.
# For legacy deployments, an unset FRONTEND_PROXY_TOKEN falls back to AUTOPILOT_TOKEN.
AUTOPILOT_TOKEN=replace-with-a-long-random-secret
FRONTEND_PROXY_TOKEN=replace-with-a-different-long-random-secret
# Frontend service only:
BACKEND_API_BASE=https://your-backend.onrender.com
BACKEND_API_TOKEN=replace-with-the-same-value-as-FRONTEND_PROXY_TOKEN
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
